{
  "name": "comitia",
  "private": true,
  "scripts": {
    "comitia": "node scripts/comitia.mjs",
    "build": "pnpm -r --filter './packages/*' build",
    "start": "pnpm --filter @comitia/board start",
    "dev": "pnpm --filter @comitia/web dev",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo",
    "test": "pnpm --filter @comitia/shared build && pnpm -r --filter './packages/*' test",
    "typecheck": "pnpm --filter @comitia/shared build && pnpm --filter @comitia/board build && pnpm -r --filter './packages/*' typecheck",
    "dogfood": "bash scripts/dogfood/start.sh",
    "dogfood:stop": "bash scripts/dogfood/stop.sh",
    "dogfood:scenario1": "node scripts/dogfood/run-scenario1.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
