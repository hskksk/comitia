{
  "name": "comitia",
  "private": true,
  "scripts": {
    "comitia": "node scripts/comitia.mjs",
    "build": "pnpm -r --filter './packages/*' build",
    "start": "pnpm --filter @comitia/web build && pnpm --filter @comitia/board start",
    "dev": "pnpm --filter @comitia/web dev",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo",
    "test": "pnpm --filter @comitia/shared build && pnpm -r --filter './packages/*' test",
    "typecheck": "pnpm --filter @comitia/shared build && pnpm --filter @comitia/board build && pnpm -r --filter './packages/*' typecheck && tsc -p .railway --noEmit && node scripts/check-railway-iac.mjs",
    "dogfood": "bash scripts/dogfood/start.sh",
    "dogfood:stop": "bash scripts/dogfood/stop.sh",
    "dogfood:scenario1": "node scripts/dogfood/run-scenario1.mjs",
    "seed": "pnpm --filter @comitia/board run seed",
    "seed:reset": "pnpm --filter @comitia/board run seed:reset"
  },
  "devDependencies": {
    "railway": "^3.10.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.33.3",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
