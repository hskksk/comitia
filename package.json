{
  "name": "comitia",
  "version": "0.6.0",
  "private": true,
  "scripts": {
    "comitia": "node scripts/comitia.mjs",
    "build": "pnpm -r --filter './packages/*' build",
    "start": "pnpm --filter @comitia/web build && pnpm --filter @comitia/board start",
    "dev": "pnpm --filter @comitia/web dev",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo",
    "test": "pnpm --filter @comitia/shared build && pnpm -r --filter './packages/*' test",
    "typecheck": "pnpm --filter @comitia/shared build && pnpm --filter @comitia/board build && pnpm -r --filter './packages/*' typecheck && tsc -p .railway --noEmit && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-railway-iac.mjs",
    "dogfood": "bash scripts/dogfood/start.sh",
    "dogfood:stop": "bash scripts/dogfood/stop.sh",
    "dogfood:scenario1": "node scripts/dogfood/run-scenario1.mjs",
    "railway:push-secrets": "bash scripts/railway/push-secrets.sh",
    "seed": "pnpm --filter @comitia/board run seed",
    "seed:reset": "pnpm --filter @comitia/board run seed:reset",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run"
  },
  "dependencies": {
    "enginebay": "^1.1.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.1",
    "railway": "^3.10.0",
    "semantic-release": "^25.0.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.33.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
