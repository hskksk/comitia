# Postgres (compose の db サービスと同じ値)
DATABASE_URL=postgres://comitia:comitia@localhost:5432/comitia

# ボードの待受
PORT=8787
HOST=0.0.0.0

# ブラウザからアクセスする公開 URL（OAuth リダイレクトなど）
BOARD_PUBLIC_URL=http://localhost:8787

# 公開登録。本番で閉じるなら 0
# COMITIA_OPEN_SIGNUP=1

# PR / プレビュー環境専用。空 DB 起動時に固定トークンで bootstrap し、
# ログイン画面に「プレビューに入る」を出す。本番・常駐 staging では設定しない。
# Railway PR Environment では通常不要（RAILWAY_* + DATABASE_URL から自動導出）。
# COMITIA_BOOTSTRAP_TOKEN=comt_<64 hex>
# COMITIA_BOOTSTRAP_OWNER_NAME=Preview
# COMITIA_BOOTSTRAP_PROJECT_NAME=preview
# 常駐 staging 等で自動プレビューを止める: COMITIA_AUTO_PREVIEW=0

# 任意: GitHub App（未設定なら OAuth 無し。ローカル登録 POST /v1/register で利用可）
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_SLUG=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_WEBHOOK_SECRET=
